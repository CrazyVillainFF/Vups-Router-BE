PORT=4000
# Origins allowed to call this API (comma-separated, no trailing slash)
# Production (set in the Render dashboard): CLIENT_ORIGIN=https://vups-router-three.vercel.app
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=https://vups-router-three.vercel.app,https://your-frontend.vercel.app

# MongoDB connection string (local or Atlas). Example local: mongodb://127.0.0.1:27017/vupsrouter
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/vupsrouter?retryWrites=true&w=majority

# Session token signing secret — random, at least 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# AES-256-GCM key-encryption secret for provider API keys — random, at least 32 characters
# Generate a second, different value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ENCRYPTION_SECRET=replace-with-a-random-encryption-secret-at-least-32-chars

# Optional: HTTPS proxy hops (1 on Render/Railway/Vercel-style deployments)
# TRUST_PROXY=1

# Optional: per-user AI limits (defaults shown)
# AI_DAILY_QUOTA=100
# AI_MAX_CONCURRENCY=3

# Optional: comma-separated emails allowed to manage AI access via /api/admin/*
# ADMIN_EMAILS=admin@example.com
