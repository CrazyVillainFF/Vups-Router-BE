PORT=4000
# Origins allowed to call this API (comma-separated, no trailing slash)
# Production (set in the Render dashboard): CLIENT_ORIGIN=https://vups-router-three.vercel.app
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=https://vups-router-three.vercel.app,https://your-frontend.vercel.app
# FRONTEND_ORIGIN and FRONTEND_ORIGINS are accepted aliases for the two vars above.
# FRONTEND_ORIGIN=https://vups-router-three.vercel.app

# Wildcard origin patterns (comma-separated). "*" matches one hostname label
# (letters, digits, hyphens) — use to allow every Vercel alias of your project,
# e.g. CLIENT_ORIGIN_PATTERNS=https://vups-router-*-your-team.vercel.app
# Without this, Vercel deployment URLs and branch URLs are rejected by CORS and
# the browser shows a generic "Could not reach the backend" error.
# CLIENT_ORIGIN_PATTERNS=

# MongoDB connection string (local or Atlas). Example local: mongodb://127.0.0.1:27017/vupsrouter
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/vupsrouter?retryWrites=true&w=majority

# Session token signing secret — random, at least 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# AES-256-GCM key-encryption secret for provider API keys — random, at least 32 characters
# Generate a second, different value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ENCRYPTION_SECRET=replace-with-a-random-encryption-secret-at-least-32-chars
# Optional comma-separated previous key(s), used only while rotating.
# Set this to the old ENCRYPTION_SECRET, run npm run rotate-provider-keys -- --apply,
# verify sign-in/provider use, then remove it.
# ENCRYPTION_SECRET_PREVIOUS=

# Optional: HTTPS proxy hops (1 on Render/Railway/Vercel-style deployments)
# TRUST_PROXY=1

# Optional: per-user AI limits (defaults shown)
# AI_DAILY_QUOTA=100
# AI_MAX_CONCURRENCY=3

# Optional: comma-separated emails allowed to manage AI access via /api/admin/*
# ADMIN_EMAILS=admin@example.com

# ─── Personal provider endpoints (optional) ──────────────────────────────────
# Supported provider protocols: OpenAI Chat Completions, OpenAI Responses,
# Anthropic Messages, Azure OpenAI (api-key header), IBM watsonx (IAM token
# exchange), and Google Gemini through its OpenAI-compatible path.
# Connection checks only read the provider's model list; explicit model tests
# are the only actions that consume provider tokens.
# Localhost / private-network base URLs (Ollama, LM Studio, vLLM, LiteLLM,
# FlagshipRouter, ...) are rejected on production with an actionable message,
# because a hosted backend cannot reach your computer. Leave this unset on
# public deployments; set it only when THIS server runs inside the same private
# network as the gateways it should be allowed to call.
# ALLOW_PRIVATE_PROVIDER_URLS=true

# ─── Shared OpenRouter model (optional, recommended for production) ─────────
# When OPENROUTER_API_KEY is set, the shared model is served through OpenRouter
# (takes precedence over the Ollama shared model below). Server-side only —
# never expose this key to the frontend and never commit it.
# OPENROUTER_API_KEY=sk-or-v1-...
# By default the backend refreshes OpenRouter's /models catalog every 5 minutes
# and offers every zero-price text chat model. Missing pricing is never treated
# as free. Optional allowlist (comma-separated IDs) restricts the shared menu.
# When set, only these IDs are offered. Paid IDs work only when explicitly
# listed here; automatic fallback remains free-only, so paid models are never
# retried silently.
# OPENROUTER_MODELS=
# Preferred default and fallback free model IDs. If the default is unavailable,
# the first currently free model is used. Fallback is retried only once and only
# for transient/model-availability failures, never account-wide quota errors.
# OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Legacy alias for OPENROUTER_DEFAULT_MODEL.
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Catalog cache TTL and maximum stale age in milliseconds (defaults: 5 minutes
# and 24 hours). A recent cached catalog is served during transient outages.
# OPENROUTER_CATALOG_TTL_MS=300000
# OPENROUTER_CATALOG_STALE_MS=86400000
# Optional: comma-separated model IDs to force-enable image input for. Only used
# when OpenRouter's model metadata does not report input modalities. OpenRouter
# advertises vision support automatically, so normally this stays empty.
# OPENROUTER_VISION_MODELS=
# Maximum output tokens per shared reply. Default 4096 (long code answers);
# values are clamped server-side to 8192 to stay within safe provider limits.
# OPENROUTER_MAX_OUTPUT_TOKENS=4096
# Production must use the canonical OpenRouter endpoint. A custom override is
# ignored in production unless explicitly unlocked for a controlled test setup.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_ALLOW_CUSTOM_BASE_URL=false
# Fallback provider deadlines for calls that do not carry a caller
# cancellation signal. Chat routes do carry one, so a slow or queued model is
# not cut off by these values.
# PROVIDER_TIMEOUT_MS=60000
# PROVIDER_STREAM_TIMEOUT_MS=300000
# Chat streams send a keepalive comment while the model thinks. There is no
# total chat deadline by default; set a positive CHAT_TOTAL_TIMEOUT_MS only if
# a deployment requires one for non-streaming replies.
# CHAT_SSE_HEARTBEAT_MS=15000
# CHAT_TOTAL_TIMEOUT_MS=0

# ─── Shared Ollama model (optional) ─────────────────────────────────────────
# Every registered user gets this model without their own API key.
# OLLAMA_BASE_URL points at an Ollama server reachable from THIS backend only.
# It is never sent to browsers and is never baked into frontend code.
# Leave OLLAMA_BASE_URL empty to turn the shared model off entirely.
# OLLAMA_BASE_URL=http://10.0.0.5:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_MAX_OUTPUT_TOKENS=1024
# Optional: comma-separated installed models that accept images (e.g.
# "llava:7b,gemma3:4b"). Ollama does not report vision support, so shared
# models are treated as text-only unless listed here.
# OLLAMA_VISION_MODELS=

# ─── OmniRoute gateway (optional) ───────────────────────────────────────────
# Exposes a server-configured OmniRoute instance as an extra model group in the
# in-chat model menu. Additive: personal keys and the shared model are
# unaffected. Server-side only — the URL and key are never sent to browsers and
# never logged, and clients can never point the backend at another URL.
# Local example (the backend and OmniRoute on the same machine):
# OMNIROUTE_BASE_URL=http://localhost:20128
# OMNIROUTE_API_KEY=paste-your-omniroute-key
# Optional override. true/1/yes force-enables, false/0/no force-disables even
# when the URL and key are set. Unset = enabled automatically when both values
# above are present.
# OMNIROUTE_ENABLED=true
# Deployment caveat: a Render-hosted backend cannot reach localhost. Use a
# same-network address or a reachable HTTPS URL, or leave this unset.

# ─── Vups v3 Galax built-in model (optional, server-side only) ───────────────────
# Vups v3 Galax built-in model (optional; server-side only)
# The browser always sees the public ID "vups-v3-galax". These three values
# select the private OpenAI-compatible backend and are never sent to clients.
# When all three are omitted, Vups reuses the shared OpenRouter configuration
# above. When only some are set, the route returns a safe 503 instead of mixing
# configurations. Verify the underlying model's real streaming, vision, and
# pricing with its provider; VupsRouter does not assume them.
# VUPS_BASE_URL=https://provider.example.com/v1
# VUPS_API_KEY=
# VUPS_UNDERLYING_MODEL=
# Optional image-input policy for dedicated VUPS_* deployments: true/1/yes
# marks VUPS_UNDERLYING_MODEL itself as vision-capable; false/0/no disables
# image requests. Unset requires VUPS_VISION_MODEL for images.
# VUPS_VISION=
# Optional exact model ID used for image requests. With no VUPS_BASE_URL,
# VUPS_API_KEY, or VUPS_UNDERLYING_MODEL set, Vups uses the shared OpenRouter
# configuration and defaults this to the free vision model below. With a
# dedicated provider, set this to a vision-capable model available at
# VUPS_BASE_URL. It can also be a different model on the same OpenRouter account.
# VUPS_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# Run `npm run check:vups-vision` with the same environment to verify the image
# model against the endpoint's live /models catalog and list valid alternatives.
# Optional per-user-and-IP limit for the dedicated route (default 30 per minute).
# VUPS_CHAT_RATE_LIMIT_MAX=30
# Optional bounded retries for transient upstream 429/5xx/network failures.
# Successful streams are never restarted and exhausted daily quotas are not
# retried. Retry-After is honored only when it fits the configured cap.
# VUPS_MAX_RETRIES=2
# VUPS_RETRY_BASE_MS=500
# VUPS_RETRY_MAX_MS=8000
# VUPS_RETRY_MAX_RETRY_AFTER_MS=15000
# Output budget and streaming safety limits. The output budget is clamped to
# 256..32768 tokens. No total deadline applies by default; the idle guard only
# measures silence between chunks, and SSE comments keep the browser connection
# alive while the model is reasoning. Set a positive value to opt into a
# response-start or total deadline. Partial output is preserved and marked
# incomplete on failure.
# VUPS_MAX_OUTPUT_TOKENS=24576
# VUPS_REQUEST_TIMEOUT_MS=0
# VUPS_STREAM_START_TIMEOUT_MS=0
# VUPS_STREAM_IDLE_TIMEOUT_MS=240000
# VUPS_SSE_HEARTBEAT_MS=15000

# ─── Image attachments in chat (optional, defaults shown) ───────────────────
# Clients may attach images to the current message as base64 data or a public
# HTTPS URL; they are converted to OpenAI-compatible content parts for the
# provider and are never stored in the database (only name/type/size metadata
# is kept in history). Remote URLs are fetched by the provider, not this server.
# CHAT_IMAGE_MAX_COUNT=4
# CHAT_IMAGE_MAX_BYTES=4194304
# CHAT_IMAGE_MAX_TOTAL_BYTES=8388608

# ─── Cloudflare Workers AI image generation (optional) ──────────────────────
# Server-side only. The token needs Workers AI Read/Edit permission. Leave both
# values unset to disable image generation with a clear administrator error.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Optional overrides for testing or a controlled proxy (defaults shown).
# CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
# IMAGE_GENERATION_TIMEOUT_MS=45000
# Per-user-and-IP image requests per minute (default 5).
# IMAGE_GENERATION_RATE_LIMIT_MAX=5

# ─── Password reset email (Brevo, six-digit code) ───────────────────────────
# Private Brevo API key (Brevo dashboard -> SMTP & API -> API Keys). Server-side
# only — never expose it to the frontend and never paste a real key here.
BREVO_API_KEY=
# Verified Brevo sender address (verify it in Brevo -> Senders first).
SENDER_EMAIL=vupriseofficial@gmail.com
# Optional override of the Brevo API base URL (testing only; defaults to https://api.brevo.com)
# BREVO_API_URL=
# Optional: per-IP limits for the password reset endpoints (defaults shown)
# PASSWORD_RESET_RATE_LIMIT_MAX=10
# VERIFY_CODE_RATE_LIMIT_MAX=20
# PASSWORD_RESET_ATTEMPT_LIMIT_MAX=20
# Rolling 24-hour cap on reset codes sent per email address (default 4;
# applied identically to unknown addresses; a code that reached the provider
# counts, a request refused because delivery is failing costs nothing).
# PASSWORD_RESET_SEND_LIMIT_MAX=4
# How long one failed provider delivery keeps /api/forgot-password answering
# "no code was sent" up front, before it tries the provider again (default
# 60000 ms). Requests in this window send no email for any address.
# PASSWORD_RESET_DELIVERY_FAILING_WINDOW_MS=60000

# ─── Plugin sign-in (OAuth) connections (optional) ───────────────────────────
# Every OAuth plugin row in the catalog reads four values whose names come from
# its plugin ID in upper case: PLUGIN_OAUTH_<PLUGIN_ID>_CLIENT_ID, _CLIENT_SECRET,
# _AUTHORIZE_URL and _TOKEN_URL. The sign-in is offered only when all four are
# set; while any is missing the plugin stays "needs setup" and no request is made
# to the provider. Put real values in the hosting dashboard, never in this file
# and never in a commit.
#
# GitHub sign-in has plugin ID "github-oauth", so its prefix is
# PLUGIN_OAUTH_GITHUB_OAUTH_. Create an OAuth app under GitHub -> Settings ->
# Developer settings -> OAuth apps and enter as its callback URL the exact
# backend address below.
# PLUGIN_OAUTH_GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# PLUGIN_OAUTH_GITHUB_OAUTH_CLIENT_SECRET=
# PLUGIN_OAUTH_GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# PLUGIN_OAUTH_GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# Scopes the sign-in asks for. When this is empty no scope parameter is sent, so
# the token comes back without repository access and every repository tool fails
# with a permission error.
# PLUGIN_OAUTH_GITHUB_OAUTH_SCOPES=repo read:user
# Base URL of the web app the browser is returned to after the callback. Falls
# back to CLIENT_ORIGIN, then FRONTEND_ORIGIN.
# PLUGIN_OAUTH_CLIENT_BASE=https://vups-router-three.vercel.app
# Optional: set the callback URL outright instead of deriving it from the request
# protocol and host. Set it when a proxy terminates TLS before this server, or
# when the deployed host header is not the address the OAuth app recorded.
# PLUGIN_OAUTH_REDIRECT_BASE=https://vups-router-be.onrender.com/api/plugins/github/oauth/callback
# Per-IP request caps that affect a sign-in attempt (defaults shown). The
# callback limiter counts the browser redirect, so a shared office IP can reach
# it while testing repeatedly.
# OAUTH_CALLBACK_RATE_LIMIT_MAX=40
# PLUGIN_RATE_LIMIT_MAX=180

# ─── Background task worker ─────────────────────────────────────────────────
# Tasks are durable MongoDB records worked by an in-process scheduler, so these
# limits decide how much work runs at once and whose work it is. A claim is a
# compare-and-set on the row the worker read, so two workers cannot run the same
# task; a task is only claimable when its lease is empty or lapsed.
# How many tasks this process executes at once (defaults to AI_MAX_CONCURRENCY).
# TASK_WORKER_CONCURRENCY=3
# How many tasks belonging to ONE account may be held at once. This is the
# fairness rule: without it a twenty-task backlog from one chat occupies the
# whole pool and every other user queues behind it. A task waiting at this cap
# stays queued with no lease — delayed, never skipped. The count is read from
# the table each time a claim is taken: exact within one process (its claim
# passes never overlap) and approximate between processes, which can each see
# room before either write lands. It is a fairness limit, not a hard quota.
# Kept below the pool size so one account never owns all of it.
# TASK_USER_CONCURRENCY=2
# How long a claim is honoured before another worker may recover the task (floor
# 1000 ms). Lease renewal is what proves the runner is still alive.
# TASK_LEASE_MS=30000
# How often each scheduler looks for work (floor 50 ms). Abandoned-task
# reconciliation runs every 30 ticks.
# TASK_WORKER_TICK_MS=1000
# Set to 1 to serve /api/tasks without executing anything — for tests and for a
# deployment where only a dedicated worker process runs tasks.
# TASK_WORKER_DISABLED=
# How long a terminal task is kept before cleanup stamps expiresAt. Read once
# when the module loads, so a change needs a restart.
# TASK_RETENTION_DAYS=30

# ─── Splitting the API from the runner (optional) ────────────────────────────
# The task queue is the contract between the two services: a submission writes a
# durable row, and whichever process is allowed to execute claims it by a
# compare-and-set on that row. Both services therefore need the SAME MONGODB_URI,
# the SAME JWT_SECRET (the boot gate demands it in every role, and one value keeps
# the two halves one app even though the runner serves no browser route) and the
# SAME ENCRYPTION_SECRET (provider keys are decrypted where they are used). There
# is no second database and no per-service copy of either secret.
#
# Which half this process is. Unset = "all" = today's single-service deployment,
# with every route mounted and its own worker running. "main" answers browsers
# and never executes a task. "executor" runs tasks and mounts no browser route at
# all, so a Main-issued session cookie presented to it is a 404. A value outside
# these three stops the boot rather than guessing. Set in the hosting dashboard.
# SERVER_ROLE=all
#
# Where "main" nudges the runner that work exists, so a sleeping free instance
# starts on a submission instead of on the next poll. It is a latency hint, not
# the transport: a timeout, a refusal or a connection that never opens costs a
# delay, never the task. HTTPS in production; plain HTTP is accepted only on
# loopback, for a two-process local run. Leave unset to keep one service.
# AI_EXECUTION_URL=https://your-runner.onrender.com
#
# The shared key for /api/internal/tasks/wake and /api/internal/tasks/cancel, sent
# as x-vups-service-key. At least 32 characters, like the two secrets above, and
# set to the SAME value on both services. Anything shorter counts as unset: with
# no key, the internal routes answer 404 and nothing is ever sent. Server-side
# only — never in the frontend, never in a commit, never in a log.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SERVICE_TO_SERVICE_SECRET=
#
# The runner is a full instance of this app, not a stub: give it the SAME MONGODB_URI
# (one queue, one database), the same JWT_SECRET and the same ENCRYPTION_SECRET value
# as the API — a saved provider key only decrypts for a keyring holding the secret that
# encrypted it — plus every server-side provider credential on this file, because the
# process that asks the model is the one that needs its key. See README, "Splitting the
# API from the runner".
#
# How long that nudge may take before it is counted as lost (floor 250 ms).
# AI_DISPATCH_TIMEOUT_MS=3000
